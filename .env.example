# ==============================================================================
# solvemycase Environment Configuration
# ==============================================================================

# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Store Configuration
# Leave QDRANT_PATH set for embedded local mode (no Docker needed)
QDRANT_PATH=data/qdrant_storage
QDRANT_COLLECTION_NAME=open_india_law_corpus
# For remote Qdrant (optional, overrides QDRANT_PATH if set):
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Data Ingestion & Cache
DATA_CACHE_DIR=data/raw
LEGISLATION_SOURCE_URL=https://oss-data-in.vaquill.ai/v2026.08.1/in_central_legislation.parquet

# Agent & Verification Settings
VERIFICATION_STRICT_MODE=true
MAX_HALLUCINATION_RETRIES=2
MAX_RETRIEVED_CHUNKS=10
RERANK_TOP_K=6
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# API & UI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
